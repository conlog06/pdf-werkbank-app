{
  "name": "pdf-werkbank-app",
  "productName": "PDF Werkbank",
  "version": "1.0.1",
  "description": "PDF Werkbank als Desktop-App für Windows und macOS: Bibliothek mit Ordnern, PDF-Editor und Abgleich mit der Webseite.",
  "main": "main.js",
  "author": "Constantin Loggen <scrabby8@gmail.com>",
  "license": "UNLICENSED",
  "private": true,
  "homepage": "https://github.com/conlog06/pdf-werkbank-app",
  "scripts": {
    "start": "electron .",
    "prepare-web": "node scripts/prepare-web.mjs",
    "dist": "npm run prepare-web && electron-builder",
    "dist:win": "npm run prepare-web && electron-builder --win",
    "dist:mac": "npm run prepare-web && electron-builder --mac"
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  },
  "devDependencies": {
    "electron": "43.7.5",
    "electron-builder": "26.15.3",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "3.11.174"
  },
  "build": {
    "appId": "de.loggx.pdfwerkbank",
    "productName": "PDF Werkbank",
    "copyright": "© 2026 Constantin Loggen",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "web/**/*",
      "build/icon.png",
      "package.json"
    ],
    "fileAssociations": [
      {
        "ext": "pdf",
        "name": "PDF-Dokument",
        "role": "Editor",
        "mimeType": "application/pdf"
      }
    ],
    "afterPack": "scripts/adhoc-sign.cjs",
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "identity": null,
      "hardenedRuntime": false,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "artifactName": "PDF-Werkbank-${version}-mac-${arch}.${ext}"
    },
    "dmg": {
      "title": "PDF Werkbank ${version}"
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "PDF-Werkbank-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PDF Werkbank",
      "language": "1031"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "conlog06",
        "repo": "pdf-werkbank-app",
        "releaseType": "draft"
      }
    ]
  }
}
