{
  "name": "PDF Werkbank",
  "short_name": "PDF Werkbank",
  "description": "PDF-Editor und Notizbuch: Bibliothek mit Ordnern, Markieren mit Stift und Pencil, Texte ändern, Sync und Google-Drive-Backup.",
  "lang": "de",
  "start_url": "./library.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#dde1e8",
  "theme_color": "#1f4fd8",
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "Neues Notizbuch",
      "short_name": "Notizbuch",
      "url": "./library.html?new=notebook",
      "icons": [
        {
          "src": "icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "PDF importieren",
      "short_name": "Importieren",
      "url": "./library.html?import=1",
      "icons": [
        {
          "src": "icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ],
  "file_handlers": [
    {
      "action": "./library.html",
      "accept": {
        "application/pdf": [
          ".pdf"
        ]
      },
      "launch_type": "single-client"
    }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "files": [
        {
          "name": "pdf",
          "accept": [
            "application/pdf",
            ".pdf"
          ]
        }
      ]
    }
  },
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "categories": [
    "productivity",
    "education",
    "utilities"
  ]
}
